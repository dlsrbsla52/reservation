# ─────────────────────────────────────────────────────────────────
# 비밀값 템플릿 — 이 파일을 복사해 프로젝트 루트에 .env 를 만든다.
#   cp .env.example .env
# .env 는 .gitignore 대상이라 커밋되지 않는다. 실제 값은 .env 에만 둔다.
#
# 읽는 곳
#   - docker compose: 같은 디렉터리의 .env 를 자동으로 읽어 ${VAR} 를 치환한다.
#   - 로컬 실행(bootRun/IDE): modules/app 의 application.yml 이 spring.config.import 로 읽는다.
#   - 운영: 서버의 .env 또는 배포 파이프라인 환경변수(AWS Secrets Manager 연동 권장).
#     환경변수가 .env 보다 우선한다.
# ─────────────────────────────────────────────────────────────────

# [필수] JWT 서명 키. 32바이트 이상. app 하나가 발급·검증에 모두 쓴다.
#   생성: openssl rand -base64 48
#   운영 값은 로컬과 반드시 다르게 둔다. 값을 바꾸면 발급된 모든 토큰이 무효화된다.
JWT_SECRET=

# [선택] 서울 열린데이터광장 API 키. 비우면 정류소 일괄 등록만 실패하고 나머지는 동작한다.
SEOUL_API_KEY=

# [운영 필수: 홈페이지 이미지] 콘텐츠 이미지 저장소(Cloudflare R2). 비우면 관리자 이미지 업로드만 실패한다.
#   R2 버킷 한정 API 토큰(Object Read & Write)의 Access Key ID·Secret 을 넣는다.
#   endpoint 예: https://<계정ID>.r2.cloudflarestorage.com / public-base-url 예: https://img.mbus.co.kr
#   [로컬] local 프로필은 이 값을 읽지 않는다(운영 R2 에 붙는 사고 방지). 아래 LOCAL_CONTENT_STORAGE_* 만 읽고,
#          비워 두면 로컬 확인용 RustFS(docker-compose-local.yml, localhost:9000)와 그 전용 더미 키를 쓴다.
#          RustFS 는 로컬 확인용이며 운영에는 배포되지 않는다.
# CONTENT_STORAGE_ENDPOINT=
# CONTENT_STORAGE_REGION=auto
# CONTENT_STORAGE_BUCKET=
# CONTENT_STORAGE_ACCESS_KEY=
# CONTENT_STORAGE_SECRET_KEY=
# CONTENT_STORAGE_PUBLIC_BASE_URL=

# [선택: 로컬 전용] local 프로필·docker-compose-local.yml 의 RustFS 접속 값. 기본값은 로컬 전용 더미 값이다.
#   운영 R2 키(CONTENT_STORAGE_*)와 분리돼 있어 로컬 실행이 운영 저장소에 붙지 않는다.
# LOCAL_CONTENT_STORAGE_ACCESS_KEY=local-only-access-key
# LOCAL_CONTENT_STORAGE_SECRET_KEY=local-only-secret-key

# [운영 필수: Cloudflare Tunnel 뒤에서 운영] X-Forwarded-For 를 믿을 프록시 주소(정규식).
#   기본값(비움)은 루프백만 믿어 cloudflared 가 보낸 헤더가 무시되므로, 문의 호출 제한이 cloudflared IP 하나로 걸린다.
#   cloudflared 컨테이너 IP 하나로 좁혀 지정한다(예: 172\.18\.0\.5). 사설 대역 전체(172\.(1[6-9]|2\d|3[01])\..*)를 넣지 않는다.
# TRUSTED_PROXIES=

# [필수: Docker Compose] DB 비밀번호. 로컬·운영 compose 모두 누락 시 기동을 거부한다.
POSTGRES_PASSWORD=

# [필수: IDE/bootRun] DB 비밀번호. 같은 DB를 사용하면 POSTGRES_PASSWORD와 동일하게 지정한다.
DB_PASSWORD=

# [필수: 운영 Compose/기본 프로필] 브라우저 origin과 쿠키 HTTPS 정책.
# 로컬 HTTP 개발은 COOKIE_SECURE=false, TLS 배포는 COOKIE_SECURE=true로 명시한다.
CORS_ALLOWED_ORIGIN=
COOKIE_SECURE=

# [선택] 관리자 사이트 origin. 비우면 일반 사이트 origin과 같다.
# CORS_ADMIN_ALLOWED_ORIGIN=
# APP_PORT=8080
