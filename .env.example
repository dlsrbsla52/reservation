# ─────────────────────────────────────────────────────────────────
# 비밀값 템플릿 — 이 파일을 복사해 프로젝트 루트에 .env 를 만든다.
#   cp .env.example .env
# .env 는 .gitignore 대상이라 커밋되지 않는다. 실제 값은 .env 에만 둔다.
#
# 읽는 곳
#   - docker compose: 같은 디렉터리의 .env 를 자동으로 읽어 ${VAR} 를 치환한다.
#   - 로컬 실행(bootRun/IDE): 각 모듈 application.yml 의 spring.config.import 가 읽는다.
#   - 운영: 서버의 .env 또는 배포 파이프라인 환경변수(AWS Secrets Manager 연동 권장).
#     환경변수가 .env 보다 우선한다.
# ─────────────────────────────────────────────────────────────────

# [필수] JWT 서명 키. 32바이트 이상. 서비스 전체(gateway/iam/stop/reservation)가 같은 값을 써야 한다.
#   생성: openssl rand -base64 48
#   운영 값은 로컬과 반드시 다르게 둔다. 값을 바꾸면 발급된 모든 토큰이 무효화된다.
JWT_SECRET=

# [선택] 서울 열린데이터광장 API 키. 비우면 정류소 일괄 등록만 실패하고 나머지는 동작한다.
SEOUL_API_KEY=

# [선택] 운영 DB·Redis·CORS 등은 compose 기본값을 덮어쓸 때만 지정한다.
# POSTGRES_PASSWORD=
# CORS_ALLOWED_ORIGIN=
# CORS_ADMIN_ALLOWED_ORIGIN=
# COOKIE_SECURE=true
